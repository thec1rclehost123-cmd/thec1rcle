rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isImageUnder5Mb() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Host verification documents are private to the owner; Admin SDK bypasses rules.
    match /hosts/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImageUnder5Mb();
    }

    // KYC documents are never public; Admin SDK bypasses rules for backend review.
    match /kyc-documents/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImageUnder5Mb();
    }

    // Verification selfies/documents are private to the owner and backend review.
    match /verifications/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImageUnder5Mb();
    }

    // Profile photos are public read, but only the owner can upload bounded images.
    match /users/{userId}/photos/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isImageUnder5Mb();
    }
    
    // Event images are public read, but client writes are admin-only.
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageUnder5Mb();
    }
  }
}
