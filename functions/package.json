{
  "name": "functions",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --external:firebase-admin --external:firebase-functions --external:razorpay --external:algoliasearch --external:qrcode --external:cors --outfile=lib/index.js",
    "build:tsc": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "algoliasearch": "^5.47.0",
    "cors": "^2.8.5",
    "firebase-admin": "^11.5.0",
    "firebase-functions": "^4.3.1",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^4.9.0"
  },
  "private": true
}
