{
  "name": "api-gateway",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/app.ts",
    "dev:staging": "tsx watch --env-file=.env.staging src/app.ts",
    "dev:prod": "tsx watch --env-file=.env.production src/app.ts",
    "start": "node --env-file=.env.production dist/app.js",
    "build": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.2",
    "firebase-admin": "^13.6.0",
    "ioredis": "^5.9.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}