{
  "name": "@c1rcle/api-gateway",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "dev": "node ../../node_modules/tsx/dist/cli.mjs watch --env-file=.env.development src/app.ts",
    "dev:staging": "node ../../node_modules/tsx/dist/cli.mjs watch --env-file=.env.staging src/app.ts",
    "dev:prod": "node ../../node_modules/tsx/dist/cli.mjs watch --env-file=.env.production src/app.ts",
    "start": "node --env-file=.env.production dist/app.js",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "build": "node ../../node_modules/typescript/bin/tsc",
    "lint": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "type-check": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "openapi:guest": "node ../../node_modules/tsx/dist/cli.mjs src/openapi/write-guest-v1-json.ts",
    "backfill:public-discovery": "node ../../node_modules/tsx/dist/cli.mjs --env-file=.env.development src/scripts/backfill-public-discovery.ts"
  },
  "dependencies": {
    "@c1rcle/core": "*",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.0",
    "@fastify/websocket": "^11.2.0",
    "@sentry/node": "^10.41.0",
    "dotenv": "^17.2.3",
    "eslint-config-next": "16.1.7",
    "expo": "55.0.7",
    "fastify": "^5.2.2",
    "firebase": "12.10.0",
    "firebase-admin": "^13.7.0",
    "ioredis": "^5.9.3",
    "next": "16.1.7",
    "pino": "^9.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "colorette": "^2.0.20",
    "fast-copy": "^4.0.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
