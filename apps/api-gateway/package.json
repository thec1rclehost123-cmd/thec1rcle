{
  "name": "@c1rcle/api-gateway",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/app.ts",
    "dev:staging": "tsx watch --env-file=.env.staging src/app.ts",
    "dev:prod": "tsx watch --env-file=.env.production src/app.ts",
    "start": "node dist/app.js",
    "build": "npx tsc && npx fix-esm-import-path dist",
    "test": "vitest run",
    "backfill:public-discovery": "tsx --env-file=.env.development src/scripts/backfill-public-discovery.ts"
  },
  "dependencies": {
    "@c1rcle/core": "*",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.3.0",
    "@sentry/node": "^10.68.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "firebase-admin": "^13.6.0",
    "ioredis": "^5.11.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "4.1.9",
    "fix-esm-import-path": "^1.10.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  }
}
