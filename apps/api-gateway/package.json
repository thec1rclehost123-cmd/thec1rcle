{
  "name": "@c1rcle/api-gateway",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch --exclude 'node_modules/**' --exclude '../../node_modules/**' --env-file-if-exists=.env.development src/app.ts",
    "dev:staging": "tsx watch --env-file=.env.staging src/app.ts",
    "dev:prod": "tsx watch --env-file=.env.production src/app.ts",
    "start": "node dist/app.js",
    "build": "npx tsc && npx fix-esm-import-path dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "backfill:public-discovery": "tsx --env-file=.env.development src/scripts/backfill-public-discovery.ts",
    "debug:venues": "node --env-file=.env.development debug_venues_list.js",
    "debug:discovery": "node --env-file=.env.development debug_discovery_execution.js",
    "debug:redis": "node --env-file=.env.development debug_redis.js",
    "debug:venues-all": "node --env-file=.env.development debug_venues_all_fields.js"
  },
  "dependencies": {
    "@c1rcle/core": "*",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@sentry/node": "^10.58.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.2",
    "firebase-admin": "^13.6.0",
    "ioredis": "^5.9.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "4.1.9",
    "fix-esm-import-path": "^1.10.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  }
}
