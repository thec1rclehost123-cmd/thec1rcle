# THE C1RCLE — API Gateway Environment Variables
# Copy this to .env.development / .env.staging / .env.production and fill in values.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Firebase Admin SDK (server-side only — never expose to clients) ────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Wrap the private key in quotes; keep the literal \n sequences — they become real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=
# Use MEILISEARCH_API_KEY in production (scoped search-only key)
MEILISEARCH_API_KEY=

# ── Signing Secrets (required in production) ──────────────────────────────────
TICKET_SECRET=c1rcle-secret-2025
QR_SECRET_KEY=replace-with-strong-random-qr-secret
QUEUE_SECRET_KEY=c1rcle-surge-protection-2024
SCANNER_SESSION_SECRET=replace-with-strong-random-scanner-session-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Error Monitoring ──────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Feature Flags ─────────────────────────────────────────────────────────────
DEV_TOY_MODE=false
