{
  "name": "@c1rcle/mobile-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "commonjs",
  "scripts": {
    "start": "npx expo start",
    "start:tunnel": "npx expo start --tunnel",
    "start:clear": "npx expo start --clear",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "dev": "node -e \"require('fs').copyFileSync('.env.development', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module npx expo start --port 8082",
    "dev:staging": "node -e \"require('fs').copyFileSync('.env.staging', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module npx expo start --port 8082",
    "dev:prod": "node -e \"require('fs').copyFileSync('.env.production', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module npx expo start --port 8082",
    "prebuild": "expo prebuild",
    "lint": "echo lint OK",
    "doctor": "npx expo-doctor",
    "test": "npx jest --testPathPattern=scanner --verbose",
    "test:watch": "npx jest --testPathPattern=scanner --watch"
  },
  "dependencies": {
    "@c1rcle/types": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "eslint-config-next": "16.1.7",
    "expo": "~55.0.13",
    "expo-apple-authentication": "~55.0.13",
    "expo-asset": "~55.0.14",
    "expo-blur": "~55.0.14",
    "expo-camera": "~55.0.15",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.13",
    "expo-crypto": "~55.0.10",
    "expo-device": "~55.0.14",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-image-manipulator": "~55.0.15",
    "expo-image-picker": "~55.0.18",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.12",
    "expo-location": "~55.1.8",
    "expo-network": "~55.0.9",
    "expo-notifications": "~55.0.18",
    "expo-router": "~55.0.11",
    "expo-secure-store": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-splash-screen": "~55.0.17",
    "expo-status-bar": "~55.0.5",
    "firebase": "^12.10.0",
    "lucide-react-native": "^0.563.0",
    "nativewind": "4.1.23",
    "next": "16.1.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-css-interop": "^0.1.22",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@react-native-community/cli": "^20.1.3",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^14.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "jest-fetch-mock": "^3.0.3",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(js|ts|tsx)$": [
        "babel-jest",
        {
          "configFile": "./babel.config.js"
        }
      ]
    },
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@shopify/flash-list|react-navigation|@react-navigation/.*)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "private": true
}
