{
  "name": "@c1rcle/mobile-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "commonjs",
  "scripts": {
    "start": "npx expo start",
    "start:tunnel": "npx expo start --tunnel",
    "start:clear": "npx expo start --clear",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "dev": "node -e \"require('fs').copyFileSync('.env.development', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module npx expo start --port 8082",
    "dev:staging": "node -e \"require('fs').copyFileSync('.env.staging', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module npx expo start --port 8082",
    "dev:prod": "node -e \"require('fs').copyFileSync('.env.production', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module npx expo start --port 8082",
    "prebuild": "expo prebuild",
    "lint": "echo lint OK",
    "doctor": "npx expo-doctor",
    "test": "npx jest --testPathPattern=scanner --verbose",
    "test:watch": "npx jest --testPathPattern=scanner --watch"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "eslint-config-next": "16.1.7",
    "expo": "55.0.7",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.12",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.10.0",
    "lucide-react-native": "^0.563.0",
    "nativewind": "^4.1.23",
    "next": "16.1.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.1.22",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^14.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "jest-fetch-mock": "^3.0.3",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(js|ts|tsx)$": ["babel-jest", {"configFile": "./babel.config.js"}]
    },
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@shopify/flash-list|react-navigation|@react-navigation/.*)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "private": true
}
