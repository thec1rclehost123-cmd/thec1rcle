{
  "name": "@c1rcle/mobile-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "commonjs",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start",
    "start:tunnel": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --tunnel",
    "start:clear": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --clear",
    "android": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --android",
    "ios": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" node scripts/start-ios-no-osascript.cjs",
    "web": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --web",
    "dev": "node -e \"require('fs').copyFileSync('.env.development', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --port 8082",
    "dev:staging": "node -e \"require('fs').copyFileSync('.env.staging', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --port 8082",
    "dev:prod": "node -e \"require('fs').copyFileSync('.env.production', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --port 8082",
    "prebuild": "expo prebuild",
    "lint": "eslint app components hooks lib store __tests__",
    "doctor": "npx expo-doctor",
    "launch:readiness": "node scripts/launch-readiness-check.cjs",
    "release:android:inspect": "cd android && ./gradlew :app:printReleaseReadiness --console=plain",
    "release:android:verify": "cd android && ./gradlew :app:verifyReleaseReadiness --console=plain",
    "release:config:test": "node --test scripts/release-hardening.test.cjs",
    "eas-build-post-install": "node scripts/eas-build-production-guard.cjs",
    "type-check": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "npx jest --verbose",
    "test:watch": "npx jest --watch"
  },
  "dependencies": {
    "@c1rcle/types": "file:../../packages/types",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/auth": "^25.1.0",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@sentry/react-native": "~8.19.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-application": "~55.0.17",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.16",
    "expo-auth-session": "~55.0.17",
    "expo-blur": "~55.0.16",
    "expo-brightness": "~55.0.15",
    "expo-build-properties": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.19",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.12",
    "expo-navigation-bar": "~55.0.15",
    "expo-network": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-video": "~55.0.19",
    "expo-web-browser": "~55.0.18",
    "firebase": "^12.10.0",
    "lucide-react-native": "^0.563.0",
    "nativewind": "4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-css-interop": "^0.1.22",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.27.2",
    "react-native-purchases": "^8.10.0",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.7.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@react-native-community/cli": "^20.1.3",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^14.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "jest-fetch-mock": "^3.0.3",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "watchman": false,
    "transform": {
      "^.+\\.(js|ts|tsx)$": [
        "babel-jest",
        {
          "configFile": "./babel.config.js"
        }
      ]
    },
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|webp|svg)$": "<rootDir>/__mocks__/fileMock.js",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-firebase|expo(nent)?|@expo(nent)?/.*|@shopify/flash-list|react-navigation|@react-navigation/.*)/)"
    ]
  },
  "private": true
}
