{
  "name": "@c1rcle/mobile-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "commonjs",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start",
    "start:tunnel": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --tunnel",
    "start:clear": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --clear",
    "android": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --android",
    "ios": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" node scripts/start-ios-no-osascript.cjs",
    "web": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --web",
    "dev": "node -e \"require('fs').copyFileSync('.env.development', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --port 8082",
    "dev:staging": "node -e \"require('fs').copyFileSync('.env.staging', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --port 8082",
    "dev:prod": "node -e \"require('fs').copyFileSync('.env.production', '.env')\" && cross-env NODE_OPTIONS=--no-experimental-require-module PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" npx expo start --port 8082",
    "prebuild": "expo prebuild",
    "lint": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "type-check": "tsc --noEmit",
    "test": "npx jest --testPathPattern=scanner --verbose",
    "test:watch": "npx jest --testPathPattern=scanner --watch"
  },
  "dependencies": {
    "@c1rcle/types": "file:../../packages/types",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~56.0.12",
    "expo-apple-authentication": "~56.0.4",
    "expo-asset": "~56.0.17",
    "expo-blur": "~56.0.3",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.19",
    "expo-image-picker": "~56.0.18",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-location": "~56.0.18",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.18",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-video": "~56.1.4",
    "firebase": "^12.10.0",
    "lucide-react-native": "^0.563.0",
    "nativewind": "4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "^0.1.22",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-image-colors": "^2.6.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@react-native-community/cli": "^20.1.3",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^14.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "jest-fetch-mock": "^3.0.3",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(js|ts|tsx)$": [
        "babel-jest",
        {
          "configFile": "./babel.config.js"
        }
      ]
    },
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@shopify/flash-list|react-navigation|@react-navigation/.*)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "private": true
}
