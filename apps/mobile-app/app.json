{
  "expo": {
    "name": "THE C1RCLE",
    "slug": "thec1rcle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "c1rcle",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/845316d6-f91c-4178-933f-807fd4758d68",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#161616"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.c1rcle.app",
      "backgroundColor": "#161616",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:thec1rcle.com",
        "applinks:api.thec1rcle.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "THE C1RCLE needs your location to show you exclusive nightlife events happening near you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "THE C1RCLE needs background location access to share your location with friends during events.",
        "NSCameraUsageDescription": "THE C1RCLE needs camera access so you can take a profile picture to connect with other event attendees.",
        "NSPhotoLibraryUsageDescription": "THE C1RCLE needs photo library access to set your profile picture.",
        "NSUserTrackingUsageDescription": "This identifier helps us deliver relevant event recommendations and measure ad performance.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["c1rcle", "com.googleusercontent.apps.GOOGLE_IOS_CLIENT_ID"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#161616"
      },
      "package": "com.c1rcle.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.GOOGLE_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow THE C1RCLE to access your location for safety features."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F44A22"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow THE C1RCLE to access your camera for scanning ticket QR codes."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "privacyManifests": {
              "NSPrivacyCollectedDataTypes": [
                {
                  "NSPrivacyCollectedDataType": "Name",
                  "NSPrivacyCollectedDataTypeLinked": true,
                  "NSPrivacyCollectedDataTypeTracking": false,
                  "NSPrivacyCollectedDataTypePurposes": ["AppFunctionality"]
                },
                {
                  "NSPrivacyCollectedDataType": "EmailAddress",
                  "NSPrivacyCollectedDataTypeLinked": true,
                  "NSPrivacyCollectedDataTypeTracking": false,
                  "NSPrivacyCollectedDataTypePurposes": ["AppFunctionality"]
                },
                {
                  "NSPrivacyCollectedDataType": "CoarseLocation",
                  "NSPrivacyCollectedDataTypeLinked": true,
                  "NSPrivacyCollectedDataTypeTracking": false,
                  "NSPrivacyCollectedDataTypePurposes": ["AppFunctionality"]
                }
              ],
              "NSPrivacyAccessedApiTypes": [
                {
                  "NSPrivacyAccessedApiType": "NSPrivacyAccessedApiTypeUserDefaults",
                  "NSPrivacyAccessedApiPurposes": ["AppFunctionality"],
                  "NSPrivacyAccessedApiReasons": ["CA92.1"]
                }
              ]
            }
          }
        }
      ],
      "expo-image",
      [
        "react-native-purchases",
        {
          "ios": {
            "apiKey": "$REVENUECAT_IOS_API_KEY"
          },
          "android": {
            "apiKey": "$REVENUECAT_ANDROID_API_KEY"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "845316d6-f91c-4178-933f-807fd4758d68"
      }
    }
  }
}
