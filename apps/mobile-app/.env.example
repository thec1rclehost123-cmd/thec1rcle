# THE C1RCLE - Mobile App Environment Variables
# Copy this to .env and fill in appropriate values

# ─── API Base URL ────────────────────────────────────────────────
# Points to the guest-portal Next.js app (same backend as website)
# In production, this is your deployed guest-portal domain
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ─── Firebase Configuration ─────────────────────────────────────
# Must match the same Firebase project used by guest-portal and partner-dashboard
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ─── Razorpay (Public Key Only) ──────────────────────────────────
# The public/test key — server keeps the secret key
EXPO_PUBLIC_RAZORPAY_KEY=rzp_test_UaS7oqTKOwuALQ

# ─── Google Sign-In ─────────────────────────────────────────────
# Web Client ID from Firebase Console > Authentication > Sign-in method > Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ─── Sentry (Crash Reporting) ───────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=

# ─── Google Maps (Android) ──────────────────────────────────────
# Required for react-native-maps on Android
# Get from: Google Cloud Console > APIs & Services > Credentials
GOOGLE_MAPS_API_KEY=
