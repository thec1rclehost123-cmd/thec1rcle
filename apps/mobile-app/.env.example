# THE C1RCLE - Mobile App Environment Variables
# Copy this to .env and fill in appropriate values

# â”€â”€â”€ API Base URL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Points to the API gateway. Local dev can omit this and the app will derive the
# gateway host from the Expo dev server.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GATEWAY_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=development

# â”€â”€â”€ Firebase Configuration â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Must match the same Firebase project used by guest-portal and partner-dashboard
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# â”€â”€â”€ Razorpay (Public Key Only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Public key only. Server-side Razorpay secrets must never be exposed here.
EXPO_PUBLIC_RAZORPAY_KEY=

# â”€â”€â”€ Google Sign-In â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Web Client ID from Firebase Console > Authentication > Sign-in method > Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# First-run authentication and controlled rollout
# Firebase email action destination. Never include an email or other PII in this URL.
EXPO_PUBLIC_AUTH_ACTION_URL=https://thec1rcle.com/app/email-verified
# Instant kill switches (false/off/0/no disable).
EXPO_PUBLIC_FIRST_RUN_V2_ENABLED=true
EXPO_PUBLIC_ONBOARDING_V2_REQUIRED=true
EXPO_PUBLIC_EXPLORE_RECOMMENDATIONS_V2=true
EXPO_PUBLIC_CONTEXTUAL_PERMISSIONS_ENABLED=true
# Deterministic rollout percentage and comma-separated mobile platform allowlist.
EXPO_PUBLIC_FIRST_RUN_V2_PERCENT=100
EXPO_PUBLIC_FIRST_RUN_V2_PLATFORMS=ios,android

# â”€â”€â”€ Sentry (Crash Reporting) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DEBUG=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# â”€â”€â”€ Google Maps (Android) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Required for react-native-maps on Android
# Get from: Google Cloud Console > APIs & Services > Credentials
GOOGLE_MAPS_API_KEY=

# ─── RevenueCat (In-App Purchases) ───────────────────────────────────────────
# Required for Premium subscriptions. Get from RevenueCat Dashboard > Projects > [App] > API Keys.
EXPO_PUBLIC_RC_IOS=
EXPO_PUBLIC_RC_ANDROID=
