# THE C1RCLE — Admin Console Environment Variables
# Copy this to .env.development / .env.staging / .env.production and fill in values.

# ── Firebase Client SDK (public — safe for browser) ───────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin SDK (server-side only — never expose to browser) ────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Wrap the private key in quotes; keep the literal \n sequences — they become real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# ── Transactional Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=

# ── SMS Verification (Msg91) ──────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API Gateway ───────────────────────────────────────────────────────────────
PUBLIC_API_URL=http://localhost:4000/api/v1
INTERNAL_API_KEY=
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# ── Partner Dashboard URL (used in email links) ───────────────────────────────
NEXT_PUBLIC_DASHBOARD_URL=https://partners.thec1rcle.com

# ── Signing Secrets ───────────────────────────────────────────────────────────
TICKET_SECRET=c1rcle-secret-2025

# ── Admin Provisioning ────────────────────────────────────────────────────────
ADMIN_PROVISION_SECRET=

# ── Error Monitoring ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=c1rcle
SENTRY_PROJECT=admin-console

# ── City & Discovery ──────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_CITY=Pune

# ── Feature Flags ─────────────────────────────────────────────────────────────
DEV_TOY_MODE=false
