{
  "name": "@c1rcle/guest-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:staging": "node -e \"require('fs').copyFileSync('.env.staging', '.env.local')\" && next dev --webpack",
    "dev:prod": "node -e \"require('fs').copyFileSync('.env.production', '.env.local')\" && next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "npx tsc --noEmit",
    "type-check": "npx tsc --noEmit",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "dependencies": {
    "@c1rcle/core": "*",
    "@c1rcle/ui": "*",
    "@opentelemetry/api": "^1.9.0",
    "@sentry/nextjs": "^10.41.0",
    "@tanstack/react-query": "^5.90.21",
    "algoliasearch": "^5.47.0",
    "clsx": "^2.1.1",
    "expo": "55.0.7",
    "firebase": "12.10.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^11.2.6",
    "lenis": "^1.3.15",
    "lucide-react": "^0.554.0",
    "next": "^16.1.7",
    "next-themes": "^0.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.5",
    "resend": "^6.5.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.12",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.16",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^16.1.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "5.9.3"
  }
}
