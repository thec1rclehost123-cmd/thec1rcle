{
    "$schema": "https://turbo.build/schema.json",
    "globalEnv": [
        "NODE_ENV",
        "VERCEL_URL",
        "NEXT_PUBLIC_VERCEL_URL"
    ],
    "tasks": {
        "build": {
            "dependsOn": [],
            "env": [
                "FIREBASE_PROJECT_ID",
                "FIREBASE_CLIENT_EMAIL",
                "FIREBASE_PRIVATE_KEY",
                "RESEND_API_KEY",
                "TICKET_SECRET",
                "GEMINI_API_KEY",
                "NEXT_PUBLIC_FIREBASE_API_KEY",
                "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN",
                "NEXT_PUBLIC_FIREBASE_PROJECT_ID",
                "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET",
                "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID",
                "NEXT_PUBLIC_FIREBASE_APP_ID"
            ],
            "outputs": [
                ".next/**",
                "dist/**",
                "lib/**",
                "!.next/cache/**"
            ]
        },
        "lint": {
            "inputs": [
                "src/**/*",
                "app/**/*",
                "components/**/*",
                "lib/**/*",
                "hooks/**/*",
                "store/**/*",
                "functions/**/*",
                "styles/**/*.css",
                ".eslintrc.*"
            ],
            "outputs": []
        },
        "test": {
            "inputs": [
                "src/**/*.{ts,tsx,js,jsx}",
                "app/**/*.{ts,tsx,js,jsx}",
                "components/**/*.{ts,tsx,js,jsx}",
                "lib/**/*.{ts,tsx,js,jsx}",
                "**/*.test.{ts,tsx,js,jsx}"
            ],
            "outputs": [
                "coverage/**"
            ]
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "type-check": {
            "inputs": [
                "src/**/*",
                "app/**/*",
                "components/**/*",
                "lib/**/*",
                "tsconfig.json"
            ],
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
