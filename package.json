{
  "name": "@c1rcle/monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "turbo dev --filter=!@c1rcle/mobile-app",
    "dev:guest": "turbo run dev --filter=@c1rcle/guest-portal",
    "dev:partner": "turbo run dev --filter=@c1rcle/partner-dashboard",
    "dev:admin": "turbo run dev --filter=@c1rcle/admin-console",
    "dev:mobile": "npm run dev --workspace=apps/mobile-app",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "build": "turbo build",
    "lint": "turbo lint --cache-dir=.turbo",
    "type-check": "turbo type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "doctor:stack": "node scripts/doctor-stack.mjs",
    "guardrails:check": "node scripts/check-backend-boundaries.mjs",
    "guardrails:inventory": "node scripts/generate-phase0-route-inventory.mjs",
    "architecture:guest": "node scripts/audit-guest-portal-architecture.mjs --check",
    "backfill:event-partners": "node scripts/backfill-event-partner-snapshots.mjs",
    "test:guardrails": "node --test scripts/check-backend-boundaries.test.mjs",
    "install:all": "npx npm install",
    "postinstall": "node scripts/patchExpoRouter.js"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "ajv": "^8.18.0",
    "colorette": "^2.0.20",
    "turbo": "^2.7.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@types/three": "^0.150.2",
    "dotenv": "^17.2.3",
    "three": "^0.162.0"
  }
}
