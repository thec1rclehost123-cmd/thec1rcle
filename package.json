{
  "name": "@c1rcle/monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "type": "module",
  "workspaces": [
    "apps/*",
    "!apps/mobile-app-backup",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:guest": "npm run dev -w apps/guest-portal",
    "dev:partner": "npm run dev -w apps/partner-dashboard",
    "dev:admin": "npm run dev -w apps/admin-console",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3005/api/inngest",
    "docker:up": "docker compose up -d redis api-gateway --build",
    "docker:down": "docker compose down",
    "build": "turbo build --concurrency=1",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "install:all": "npm install",
    "prepare": "node scripts/prepare-husky.mjs",
    "format:check": "prettier --check .",
    "stylelint:check": "stylelint \"**/*.css\" --allow-empty-input",
    "test:integration": "echo 'No integration tests configured yet' && exit 0",
    "guardrails:check": "node scripts/check-backend-boundaries.mjs",
    "test:guardrails": "node --test scripts/check-backend-boundaries.test.mjs",
    "architecture:guest": "npm test -w apps/guest-portal",
    "prepush": "npm run lint && npm run stylelint:check && npm run type-check && (npm test || echo Tests non-blocking per CI continue-on-error policy) && cross-env SKIP_ENV_VALIDATION=1 npm run build && npm run guardrails:check"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,jsx,ts,tsx}": "eslint --fix --no-ignore",
    "*.css": "stylelint --fix --allow-empty-input"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^12.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "cross-env": "^10.1.0",
    "expo": "^56.0.12",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.8.4",
    "size-limit": "^12.1.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "^2.7.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@xmldom/xmldom": ">=0.9.0",
    "tar": ">=7.5.16",
    "tmp": ">=0.2.7"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.1",
    "@esbuild/darwin-x64": "^0.28.1",
    "@esbuild/linux-x64": "^0.28.1",
    "@esbuild/win32-x64": "^0.28.1",
    "@next/swc-linux-x64-gnu": "^16.2.12",
    "@next/swc-linux-x64-musl": "^16.2.12"
  }
}