{
  "name": "@c1rcle/monorepo",
  "private": true,
  "packageManager": "npm@11.6.2",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:guest": "npm run dev -w apps/guest-portal",
    "dev:partner": "npm run dev -w apps/partner-dashboard",
    "dev:admin": "npm run dev -w apps/admin-console",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3005/api/inngest",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "install:all": "npm install",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "stylelint:check": "stylelint \"**/*.css\" --allow-empty-input",
    "test:integration": "echo 'No integration tests configured yet' && exit 0",
    "guardrails:check": "node scripts/check-backend-boundaries.mjs",
    "test:guardrails": "node --test scripts/check-backend-boundaries.test.mjs",
    "prepush": "npm run lint && npm run stylelint:check && npm run type-check && npm test && npm run build && npm run guardrails:check"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,jsx,ts,tsx}": "eslint --fix --no-ignore",
    "*.css": "stylelint --fix --allow-empty-input"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^12.1.0",
    "@vitest/coverage-v8": "^4.0.18",
    "expo": "^56.0.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "size-limit": "^12.1.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "^2.7.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
