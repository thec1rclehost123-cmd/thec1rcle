{
  "name": "@c1rcle/monorepo",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=!@c1rcle/mobile-app --filter=!@c1rcle/scanner-app",
    "dev:guest": "turbo run dev --filter=@c1rcle/guest-portal",
    "dev:partner": "turbo run dev --filter=@c1rcle/partner-dashboard",
    "dev:admin": "turbo run dev --filter=@c1rcle/admin-console",
    "dev:mobile": "npm run dev --workspace=apps/mobile-app",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3005/api/inngest",
    "build": "turbo build",
    "lint": "turbo lint --cache-dir=.turbo",
    "type-check": "turbo type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "install:all": "npx npm install",
    "postinstall": "node scripts/patchExpoRouter.js"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "ajv": "^8.18.0",
    "colorette": "^2.0.20",
    "expo": "^55.0.8",
    "next": "^16.1.7",
    "turbo": "^2.7.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
